#!/usr/bin/env bun
// Pick a URL out of a herdr pane and open or copy it.
//
// A herdr equivalent of tmux-urlview. Reads the invoking pane's scrollback
// through the herdr socket API, extracts URLs, and offers them in an fzf picker.
//
//   Enter   open in the default browser
//   Ctrl-Y  copy to the clipboard instead
//   Esc     cancel
//
// HERDR_URLVIEW_LINES sets how much scrollback to scan (default 5000).
//
// Uses node: imports throughout, so it runs unchanged under node.

import { existsSync } from "node:fs";
import { join, delimiter } from "node:path";
import { spawnSync, spawn } from "node:child_process";

// Deliberately conservative: terminals wrap and decorate output, so anything
// clever produces more false positives than it recovers real links.
const URL_RE =
  /((?:https?|ftp|file):\/\/[^\s<>"'`\[\]{}|\\^]+|www\.[^\s<>"'`\[\]{}|\\^]+)/gi;

// Punctuation far more likely to be prose than part of the URL.
const TRAILING = new Set([".", ",", ";", ":", "!", "?", "'", '"', ")", "]", "}", ">"]);

const DEFAULT_LINES = 5000;

function which(name) {
  for (const dir of (process.env.PATH || "").split(delimiter)) {
    if (!dir) continue;
    const candidate = join(dir, name);
    if (existsSync(candidate)) return candidate;
  }
  return null;
}

function herdr(...args) {
  const bin = process.env.HERDR_BIN_PATH || "herdr";
  const result = spawnSync(bin, args, { encoding: "utf8" });
  if (result.status !== 0) {
    throw new Error(`herdr ${args.join(" ")} failed: ${(result.stderr || "").trim()}`);
  }
  return result.stdout;
}

// herdr passes the invoking pane in the environment. When it does not (run by
// hand, or from a popup that carries no pane context), fall back to whichever
// pane the server reports as focused.
function sourcePaneId() {
  if (process.env.HERDR_PANE_ID) return process.env.HERDR_PANE_ID;

  const context = process.env.HERDR_PLUGIN_CONTEXT_JSON;
  if (context) {
    try {
      const data = JSON.parse(context);
      const pane = data?.pane_id ?? data?.pane?.pane_id;
      if (pane) return pane;
    } catch {}
  }

  const panes = JSON.parse(herdr("pane", "list"))?.result?.panes ?? [];
  const focused = panes.find((p) => p.focused);
  if (focused) return focused.pane_id;
  if (panes.length) return panes[0].pane_id;
  throw new Error("no panes reported by herdr");
}

function paneText(paneId, lines) {
  return herdr(
    "pane", "read", paneId,
    "--source", "recent-unwrapped",
    "--lines", String(lines),
    "--format", "text",
  );
}

function extract(text) {
  const seen = new Set();

  for (const match of text.matchAll(URL_RE)) {
    const raw = match[1];

    let url = raw;
    while (url.length && TRAILING.has(url[url.length - 1])) url = url.slice(0, -1);

    // Keep a closing paren that belongs to the URL, e.g. wiki_(disambiguation)
    const opens = (url.match(/\(/g) || []).length;
    const closes = (url.match(/\)/g) || []).length;
    if (opens > closes && raw.endsWith(")")) url += ")";

    if (url.length < 8) continue;
    seen.add(url);
  }

  // Most recent output is at the bottom, and that is usually what you want.
  return [...seen].reverse();
}

function pick(urls) {
  const fzf = which("fzf");
  if (!fzf) throw new Error("fzf is required but was not found on PATH");

  const result = spawnSync(
    fzf,
    [
      "--prompt=url> ",
      "--height=100%",
      "--reverse",
      "--no-multi",
      "--expect=ctrl-y",
      `--header=enter open   ctrl-y copy   (${urls.length} found)`,
    ],
    { input: urls.join("\n"), encoding: "utf8", stdio: ["pipe", "pipe", "inherit"] },
  );

  // 130 is the conventional "user pressed escape or Ctrl-C" exit.
  if (![0, 1, 130].includes(result.status)) {
    throw new Error(`fzf failed (${result.status})`);
  }

  const lines = (result.stdout || "").split("\n");
  if (lines.length < 2 || !lines[1].trim()) return null;
  return { key: lines[0].trim(), url: lines[1].trim() };
}

function open(url) {
  if (process.platform === "darwin") {
    return spawn("open", [url], { detached: true, stdio: "ignore" }).unref();
  }
  const xdg = which("xdg-open");
  if (xdg) return spawn(xdg, [url], { detached: true, stdio: "ignore" }).unref();
  const gio = which("gio");
  if (gio) return spawn(gio, ["open", url], { detached: true, stdio: "ignore" }).unref();
  throw new Error("no xdg-open or gio found to open the URL");
}

function copy(url) {
  for (const [name, args] of [
    ["wl-copy", []],
    ["xclip", ["-selection", "clipboard"]],
    ["pbcopy", []],
  ]) {
    const bin = which(name);
    if (bin) {
      spawnSync(bin, args, { input: url, encoding: "utf8" });
      return;
    }
  }
  throw new Error("no wl-copy, xclip or pbcopy found to copy the URL");
}

function pause() {
  // Keeps the popup readable before herdr tears it down.
  spawnSync("sh", ["-c", "read -r _"], { stdio: "inherit" });
}

function main() {
  const parsed = Number.parseInt(process.env.HERDR_URLVIEW_LINES ?? "", 10);
  const lines = Number.isFinite(parsed) && parsed > 0 ? parsed : DEFAULT_LINES;

  let pane;
  let urls;
  try {
    pane = sourcePaneId();
    urls = extract(paneText(pane, lines));
  } catch (err) {
    console.error(`herdr-urlview: ${err.message}`);
    return 1;
  }

  if (!urls.length) {
    console.log(`herdr-urlview: no URLs in the last ${lines} lines of ${pane}`);
    pause();
    return 0;
  }

  try {
    const chosen = pick(urls);
    if (!chosen) return 0;
    if (chosen.key === "ctrl-y") {
      copy(chosen.url);
    } else {
      open(chosen.url.startsWith("www.") ? `https://${chosen.url}` : chosen.url);
    }
  } catch (err) {
    console.error(`herdr-urlview: ${err.message}`);
    pause();
    return 1;
  }

  return 0;
}

process.exit(main());
